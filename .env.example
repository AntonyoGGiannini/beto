# Copie para .env e preencha. NUNCA commite o .env real.

# --- Telegram (necessário só para BETO_ALERTER=telegram / comando `beto run`) ---
# Crie o bot no @BotFather e descubra seu chat id com @userinfobot
BETO_TELEGRAM_BOT_TOKEN=
BETO_TELEGRAM_CHAT_ID=

# alerter: console (imprime no terminal, não precisa de credenciais) | telegram
BETO_ALERTER=console

# --- Casas habilitadas (separadas por vírgula; "mock" disponível p/ teste do pipeline) ---
BETO_ENABLED_HOUSES=novibet,superbet,sportingbet,betfair,betano,bet365,betnacional

# --- Filtro de competição (substring, sem acento/caixa; vazio = todas) ---
BETO_COMPETITION_INCLUDE=copa do mundo,world cup,fifa world cup
BETO_COMPETITION_EXCLUDE=clube,feminin,sub-,futsal,eliminat,qualif,esoccer,e-football

# --- Monitoramento ---
BETO_SCRAPE_INTERVAL_S=60
BETO_MIN_PROFIT_PCT=0.5
BETO_BANKROLL=1000
BETO_DEDUP_TTL_S=1800

# --- Matching de eventos ---
BETO_FUZZY_THRESHOLD=85
BETO_MATCH_TIME_WINDOW_MIN=30

# --- Scraping / politeness ---
BETO_REQUEST_TIMEOUT_S=20
BETO_REQUEST_MIN_DELAY_S=0.8
BETO_REQUEST_MAX_DELAY_S=2.5
BETO_HEADLESS=true
BETO_RENDER_WAIT_MS=8000
# Proxy opcional (httpx + Playwright). Vazio = sem proxy. As casas .bet.br
# geo-bloqueiam IPs estrangeiros/datacenter; rodando fora do Brasil, aponte para
# um proxy residencial BR. Ex.: http://usuario:senha@host:porta
BETO_PROXY_SERVER=

# --- Diversos ---
BETO_DB_PATH=beto.db
BETO_LOG_LEVEL=INFO
BETO_LOG_JSON=false
BETO_DEBUG_DUMP=false
BETO_DEBUG_DUMP_DIR=debug
